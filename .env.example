# ==============================================================================
# HUNTER'S KITCHEN — ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server & Network
PORT=3000
NODE_ENV=production
APP_ORIGIN=http://localhost:3000
APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# PostgreSQL 18.x Primary Relational Database Configuration
# ------------------------------------------------------------------------------
# Option A: Full Connection URI (Preferred in Cloud / Production)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hunters_kitchen

# Option B: Individual Connection Parameters (Used when DATABASE_URL is not provided)
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=hunters_kitchen
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_SSL=false
DB_POOL_MIN=4
DB_POOL_MAX=25

# ------------------------------------------------------------------------------
# Redis Fast L1/L2 Cache, Rate-Limiting & Session Invalidation Store
# ------------------------------------------------------------------------------
# Optional: In-memory fallback is automatically engaged if Redis server is unreachable
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# JWT & Session Security
# ------------------------------------------------------------------------------
JWT_SECRET=super_secret_production_jwt_key_min_32_characters_long_hunter_2026
SESSION_COOKIE_SECRET=super_secret_cookie_signing_key_hunter_2026

# ------------------------------------------------------------------------------
# Google Maps Platform API Key (Geocoding & Autocomplete)
# ------------------------------------------------------------------------------
GOOGLE_MAPS_PLATFORM_KEY=

# ------------------------------------------------------------------------------
# Google OAuth 2.0 Credentials (Authorization Code Flow)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# ------------------------------------------------------------------------------
# Gmail Real-Time OTP Verification Service
# ------------------------------------------------------------------------------
# Generate App Password in Google Account -> Security -> 2-Step Verification -> App Passwords
GMAIL_USER=
GMAIL_APP_PASSWORD=

# ------------------------------------------------------------------------------
# Gemini AI Assistant (Menu Recommendations & Dish Pairing)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
