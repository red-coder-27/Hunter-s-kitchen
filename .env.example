# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Secret key for signing role session tokens
JWT_SECRET="your_jwt_secret_key_here"

# Google Maps Platform API Key for precise geocoding and address auto-fill
GOOGLE_MAPS_PLATFORM_KEY=

# Google OAuth 2.0 Credentials (Authorization Code Flow)
# Register exact redirect URI in Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
APP_ORIGIN=http://localhost:3000

# Gmail Real-Time OTP Verification Service
# Generate App Password in Google Account -> Security -> App Passwords
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Redis Cache & Session Store (optional, in-memory cluster simulated fallback by default)
REDIS_URL=redis://localhost:6379
